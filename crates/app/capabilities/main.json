{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Flek's own UI. The sign-in window (Slack's page) gets no IPC at all.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-status",
    "allow-progress",
    "allow-conversations",
    "allow-messages",
    "allow-message",
    "allow-thread",
    "allow-import-desktop",
    "allow-sign-in",
    "allow-people",
    "allow-avatars",
    "allow-custom-emoji",
    "allow-profile",
    "allow-profile-photo",
    "allow-open-file",
    "allow-pdf-data",
    "allow-open-url",
    "allow-search",
    "allow-send-message",
    "allow-set-reaction"
  ]
}
