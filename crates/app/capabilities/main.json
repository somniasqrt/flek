{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Flek's own UI. The sign-in window (Slack's page) gets no IPC at all.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-team-icon",
    "allow-direct-messages",
    "allow-activity",
    "allow-browse-files",
    "allow-fetch-file",
    "allow-status",
    "allow-progress",
    "allow-conversations",
    "allow-messages",
    "allow-message",
    "allow-thread",
    "allow-import-desktop",
    "allow-sign-in",
    "allow-people",
    "allow-avatars",
    "allow-custom-emoji",
    "allow-profile",
    "allow-profile-photo",
    "allow-open-file",
    "allow-pdf-data",
    "allow-open-url",
    "allow-search",
    "allow-send-message",
    "allow-set-reaction",
    "allow-presence-for",
    "allow-statuses-for",
    "allow-subscribe-presence",
    "allow-set-status",
    "allow-clear-status",
    "allow-set-presence",
    "allow-snooze",
    "allow-end-snooze",
    "allow-mark-read",
    "allow-conversation-preference",
    "allow-dismiss-conversation",
    "allow-channel-info",
    "allow-conversation-link"
  ]
}
