{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Flek's own UI. The sign-in window (Slack's page) gets no IPC at all.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-platform",
    "allow-team-icon",
    "allow-direct-messages",
    "allow-activity",
    "allow-activity-seen",
    "allow-browse-files",
    "allow-fetch-file",
    "allow-status",
    "allow-progress",
    "allow-conversations",
    "allow-messages",
    "allow-timeline-range",
    "allow-timeline-window",
    "allow-timeline-after",
    "allow-date-target",
    "allow-message",
    "allow-thread",
    "allow-import-desktop",
    "allow-sign-in",
    "allow-people",
    "allow-avatars",
    "allow-custom-emoji",
    "allow-profile",
    "allow-profile-photo",
    "allow-open-file",
    "allow-document-data",
    "allow-open-url",
    "allow-search",
    "allow-send-message",
    "allow-set-reaction",
    "allow-presence-for",
    "allow-statuses-for",
    "allow-subscribe-presence",
    "allow-set-status",
    "allow-clear-status",
    "allow-set-presence",
    "allow-snooze",
    "allow-end-snooze",
    "allow-mark-read",
    "allow-conversation-preference",
    "allow-dismiss-conversation",
    "allow-channel-info",
    "allow-conversation-link",
    "allow-get-settings",
    "allow-set-settings",
    "allow-storage-info",
    "allow-clear-file-cache",
    "allow-full-resync",
    "allow-sign-out",
    "allow-account-origin",
    "allow-show-storage",
    "allow-channel-directory",
    "allow-channel-preview",
    "allow-join-channel",
    "allow-create-channel",
    "allow-validate-channel-name"
  ]
}
