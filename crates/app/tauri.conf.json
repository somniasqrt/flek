{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flek",
  "version": "0.1.0",
  "identifier": "app.flek.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "npm run dev --workspace ui",
    "beforeBuildCommand": "npm run build --workspace ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flek",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: flekfile: http://flekfile.localhost; media-src 'self' flekfile: http://flekfile.localhost; connect-src 'self' ipc: http://ipc.localhost flekfile: http://flekfile.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
